files["app/services/offline_store.py"] = textwrap.dedent("""
import sqlite3
from pathlib import Path
from app.core.config import settings

class OfflineStore:
    def __init__(self):
        self.path = Path(settings.offline_db_path)
        self.path.parent.mkdir(parents=True, exist_ok=True)
        self._init()

    def _conn(self):
        return sqlite3.connect(self.path)

    def _init(self):
        conn = self._conn()
        conn.execute("CREATE TABLE IF NOT EXISTS memory (id INTEGER PRIMARY KEY, role TEXT, content TEXT)")
        conn.commit()
        conn.close()

    def add(self, role: str, content: str):
        conn = self._conn()
        conn.execute("INSERT INTO memory(role, content) VALUES (?, ?)", (role, content))
        conn.commit()
        conn.close()

    def search(self, query: str):
        conn = self._conn()
        rows = conn.execute(
            "SELECT id, role, content FROM memory WHERE content LIKE ? ORDER BY id DESC LIMIT 20",
            (f"%{query}%",)
        ).fetchall()
        conn.close()
        return [{"id": r[0], "role": r[1], "content": r[2]} for r in rows]

    def count(self):
        conn = self._conn()
        row = conn.execute("SELECT COUNT(*) FROM memory").fetchone()
        conn.close()
        return int(row[0])

store = OfflineStore()
""").strip() + "\n"

files["app/services/ollama_service.py"] = textwrap.dedent("""
import httpx
from app.core.config import settings

async def generate_local_reply(prompt: str) -> str:
    payload = {"model": settings.ollama_model, "prompt": prompt, "stream": False}
    try:
        async with httpx.AsyncClient(timeout=90) as client:
            res = await client.post(f"{settings.ollama_base_url}/api/generate", json=payload)
            res.raise_for_status()
            return res.json().get("response", "").strip()
    except Exception:
        return ""
""").strip() + "\n"

files["app/services/search_service.py"] = textwrap.dedent("""
from app.services.offline_store import store
from app.core.config import settings

STATIC_KNOWLEDGE = [
    "offline ai brain",
    "ollama local llm integration",
    "semantic search embeddings hook",
    "offline speech recognition hook",
    "deployment hardening and readiness",
    "live listening scaffold"
]

def run_search(query: str):
    q = query.lower()
    keyword = [item for item in STATIC_KNOWLEDGE if q in item.lower()]
    semantic = [{
        "query": query,
        "mode": settings.embeddings_mode,
        "note": "semantic hook active",
        "next_step": "connect embeddings endpoint or vector database"
    }]
    return {
        "query": query,
        "keyword_results": keyword,
        "offline_memory_results": store.search(query),
        "semantic_results": semantic
    }
""").strip() + "\n"

