from fastapi import APIRouter
from pydantic import BaseModel
from app.services.offline_store import store
from app.services.ollama_service import generate_local_reply

router = APIRouter()

class ChatPayload(BaseModel):
    text: str

@router.post("/chat")
async def chat(payload: ChatPayload):
    store.add("user", payload.text)
    reply = await generate_local_reply(payload.text)
    if not reply:
        reply = f"Violet fallback processed: {payload.text}"
    store.add("assistant", reply)
    return {"response": reply, "history_count": store.count()}
